  "story.skibidi.mission.strange_toilet_activity": "Strange Toilet Activity",
  "story.skibidi.mission.strange_toilet_activity.description": "Reports of strange toilet activity in an apartment. Go take a look, and stay alive when it looks back.",
  "story.skibidi.mission.going_up": "Going Up",
  "story.skibidi.mission.going_up.description": "The elevator doors open on a row of singing urinals. There's nowhere to run, so hold on.",
  "story.skibidi.mission.the_highway": "The Highway",
  "story.skibidi.mission.the_highway.description": "A giant toilet is coming up the highway with its whole crew. Stay alive until it passes.",
  "story.skibidi.mission.the_restaurant": "The Restaurant",
  "story.skibidi.mission.the_restaurant.description": "A toilet bursts into a restaurant and the diners start changing. Survive until help comes.",
  "story.skibidi.mission.bridge_watch": "Bridge Watch",
  "story.skibidi.mission.bridge_watch.description": "Something huge is floating over the bridge, and it's dropping flying toilets. Keep your head down.",
  "story.skibidi.mission.the_nightclub": "The Nightclub",
  "story.skibidi.mission.the_nightclub.description": "There's a toilet behind the DJ booth and the whole club is singing. Survive the set.",
  "story.skibidi.mission.first_flush": "First Flush",
  "story.skibidi.mission.first_flush.description": "Find out what really stops a toilet: flush it. Then G-Man Toilet shows up. Hold out until he leaves.",
  "story.skibidi.mission.the_war_begins": "The War Begins",
  "story.skibidi.mission.the_war_begins.description": "The Cameramen march in and the toilets march out to meet them. Fight alongside the Alliance.",
  "story.skibidi.mission.the_plaza": "The Plaza",
  "story.skibidi.mission.the_plaza.description": "Two toilets are guarding a monument in the plaza. Flush them both, even the one that runs.",
  "story.skibidi.mission.the_cathedral": "The Cathedral",
  "story.skibidi.mission.the_cathedral.description": "Toilets gather to hear the Saint Toilet sing. Break in with the Cameramen and stop the service.",
  "story.skibidi.mission.triple_threat": "Triple Threat",
  "story.skibidi.mission.triple_threat.description": "A toilet with three heads leads an army down the street. Hold the line with the Cameramen.",
  "story.skibidi.mission.the_bridge": "The Bridge",
  "story.skibidi.mission.the_bridge.description": "Clear the toilets off the bridge with your squad. Then G-Man Toilet's eyes start to glow.",
  "story.skibidi.mission.strider_vs_sky": "Strider vs Sky",
  "story.skibidi.mission.strider_vs_sky.description": "Flying toilets fill the sky over the Camera Strider. Bring them down.",
  "story.skibidi.mission.fast_armored": "Fast Armored",
  "story.skibidi.mission.fast_armored.description": "Break the toilets' V formation, then deal with the black blur coming up behind it.",
  "story.skibidi.mission.baba_booey": "Baba Booey",
  "story.skibidi.mission.baba_booey.description": "A Cameraman leads a crowd of toilets into a trap. Finish off whatever walks out of the smoke.",
  "story.skibidi.mission.the_secret_lab": "The Secret Lab",
  "story.skibidi.mission.the_secret_lab.description": "A spy camera found the toilets' lab. Take down the Chief Scientist, and watch what comes out of the smoke.",
  "story.skibidi.mission.the_meeting": "The Meeting",
  "story.skibidi.mission.the_meeting.description": "G-Man Toilet is holding a meeting. Take out his guards, then survive his answer.",
  "story.skibidi.mission.titan_rising": "Titan Rising",
  "story.skibidi.mission.titan_rising.description": "The toilets are winning the street, until something enormous steps in. Fight next to Titan Cameraman.",
  "story.skibidi.mission.snack_break": "Snack Break",
  "story.skibidi.mission.snack_break.description": "Titan Cameraman takes on the triplets. Make sure nothing gets in his way.",
  "story.skibidi.mission.laser_eyes": "Laser Eyes",
  "story.skibidi.mission.laser_eyes.description": "G-Man Toilet comes for Titan Cameraman. Stand with the Titan and drive G-Man Toilet off.",
  "story.skibidi.mission.interrogation": "Interrogation",
  "story.skibidi.mission.interrogation.description": "A captured toilet won't talk. Flush it, then get out before G-Man Toilet comes for it.",
  "story.skibidi.mission.the_canal": "The Canal",
  "story.skibidi.mission.the_canal.description": "The toilets push down the canal with helicopters overhead. Hold the frontline.",
  "story.skibidi.mission.repairs": "Repairs",
  "story.skibidi.mission.repairs.description": "Titan Cameraman is down for repairs when the toilets break in. Defend the workshop.",
  "story.skibidi.mission.street_fight": "Street Fight",
  "story.skibidi.mission.street_fight.description": "The toilets keep coming down the street. Clear it, then stop the Hydra Strider.",
  "story.skibidi.mission.the_ambush": "The Ambush",
  "story.skibidi.mission.the_ambush.description": "Lead the toilets into the Speakermen's ambush. Put your headphones on.",
  "story.skibidi.mission.titan_speakerman": "Titan Speakerman",
  "story.skibidi.mission.titan_speakerman.description": "The Speakermen bring their own Titan to the fight. Clear the streets with him.",
  "story.skibidi.mission.the_hideout": "The Hideout",
  "story.skibidi.mission.the_hideout.description": "The toilets are singing in their hideout. Break the door down and raid it.",
  "story.skibidi.mission.the_mafia": "The Mafia",
  "story.skibidi.mission.the_mafia.description": "The Mafia Toilet is making a deal in a factory. Titan Speakerman tears the roof off; you finish it.",
  "story.skibidi.mission.glitch": "Glitch",
  "story.skibidi.mission.glitch.description": "The victory party is over: the Glitch Toilet is tearing through the Alliance. Stop it.",
  "story.skibidi.mission.captured": "Captured",
  "story.skibidi.mission.captured.description": "You're held in the toilets' lab while they try something new. Break free and survive.",
  "story.skibidi.mission.infected": "Infected",
  "story.skibidi.mission.infected.description": "Something is wrong with the Cameramen riding on the toilets. Fight your way out.",
  "story.skibidi.mission.giant_camo": "Giant Camo",
  "story.skibidi.mission.giant_camo.description": "A Giant Camo Toilet is wrecking the battlefield. Take it down with Titan Speakerman.",
  "story.skibidi.mission.city_on_fire": "City on Fire",
  "story.skibidi.mission.city_on_fire.description": "G-Man Toilet and the infected Titan are burning the city. Find cover and survive.",
  "story.skibidi.mission.the_hangar": "The Hangar",
  "story.skibidi.mission.the_hangar.description": "Lead the infected Large Cameraman into the secret hangar so the Alliance can save him.",
  "story.skibidi.mission.disabler_gun": "Disabler Gun",
  "story.skibidi.mission.disabler_gun.description": "The scientists' new gun works. Hold the hangar when G-Man Toilet tears the roof off.",
  "story.skibidi.mission.cure_the_army": "Cure the Army",
  "story.skibidi.mission.cure_the_army.description": "The toilets march infected Alliance members ahead of them. Free them and break the army.",
  "story.skibidi.mission.pdlt": "PDLT",
  "story.skibidi.mission.pdlt.description": "Escort the new laser tank through the city, and stop the Mutant when it charges.",
  "story.skibidi.mission.g_toilet_2": "G-Man Toilet 2.0",
  "story.skibidi.mission.g_toilet_2.description": "The tank lines up a shot on the infected Titan, and G-Man Toilet steps in front of it. This is it.",
